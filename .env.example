# Copy this file to .env.local (and add the same values to your host, e.g. Vercel) and fill it in.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with the database password you chose when creating the project.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API. Used to store proof uploads in the private "proofs" bucket.
# Keep the service role key secret — it is only ever used on the server.
# Leave both empty to save uploads to the local uploads/ folder instead (fine for local development).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign login sessions. Use any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
